---
import HomeDataLayer from "@components/layout/HomeDataLayer.astro";
import HomeHero from "@components/layout/HomeHero.astro";
import HomeTicker from "@components/layout/HomeTicker.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";
import "@/styles/components/home-section.css";
import "@/styles/components/home-hero.css";
import "@/styles/components/home-ticker.css";
import "@/styles/components/home-data-layer.css";
---

<MainGridLayout
	title={siteConfig.title}
	description={siteConfig.description}
	hasOwnH1={true}
>
	<div class="home-page">
		<HomeHero />
		<HomeTicker />
		<HomeDataLayer />
	</div>
</MainGridLayout>
